{
    "version": 2,
    "builds": [
        {
            "src": "/vercel.php",
            "use": "vercel-php@0.6.2"
        },
        {
            "src": "/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/vercel.php"
        }
    ]
}
